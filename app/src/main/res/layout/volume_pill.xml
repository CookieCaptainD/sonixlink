<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:background="@drawable/volume_pill"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="64dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp">
        <ImageView
            android:id="@+id/volumeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_volume_high"
            android:tint="@color/text_primary"
            android:contentDescription="@string/cd_volume"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:id="@+id/volumeText"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>
        <SeekBar
            android:id="@+id/volumeSeek"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:max="100"
            android:progressDrawable="@drawable/volume_track"
            android:thumb="@drawable/volume_thumb"
            android:thumbOffset="7dp"
            android:layout_weight="1"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="12dp"
            android:splitTrack="false"/>
    </LinearLayout>
</FrameLayout>
