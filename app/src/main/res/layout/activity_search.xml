<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/screen_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">
            <ImageButton
                android:id="@+id/backButton"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text_primary"
                android:contentDescription="@string/cd_back"/>
            <EditText
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/search_hint"
                android:maxLines="1"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"/>
            <ImageButton
                android:id="@+id/clearButton"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/cd_close"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/header"
            android:background="@color/surface"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp">
            <ImageButton
                android:id="@+id/headerBack"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text_primary"
                android:contentDescription="@string/cd_back"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingStart="8dp"/>
            <ImageButton
                android:id="@+id/selQueue"
                android:src="@drawable/ic_list_queue"
                android:contentDescription="@string/sel_queue"
                style="@style/CornerButton"/>
            <ImageButton
                android:id="@+id/selFavAdd"
                android:src="@drawable/ic_star_plus"
                android:contentDescription="@string/sel_fav_add"
                style="@style/CornerButton"/>
            <ImageButton
                android:id="@+id/selFavRemove"
                android:src="@drawable/ic_star_x"
                android:contentDescription="@string/sel_fav_remove"
                style="@style/CornerButton"/>
            <ImageButton
                android:id="@+id/selPlaylistAdd"
                android:src="@drawable/ic_list_plus"
                android:contentDescription="@string/sel_playlist_add"
                style="@style/CornerButton"/>
            <ImageButton
                android:id="@+id/selClose"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/cd_close"
                style="@style/CornerButton"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textColor="@color/text_secondary"
                android:layout_gravity="center"
                android:id="@+id/emptyText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_nothing"/>
        </FrameLayout>
    </LinearLayout>
    <include
        android:id="@+id/volume"
        layout="@layout/volume_pill"/>
</FrameLayout>
