<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/screen_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
        <View
            android:background="#b3121212"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="32dp">
                <View
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/handle"
                    android:background="@drawable/sheet_handle"
                    android:layout_width="38dp"
                    android:layout_height="4dp"
                    android:layout_marginBottom="10dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/coverPlaceholder"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_track"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="28dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="20sp"
                        android:textColor="@color/text_primary"
                        android:ellipsize="marquee"
                        android:id="@+id/trackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:ellipsize="marquee"
                        android:id="@+id/trackArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"/>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/favouriteButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_favourite"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@string/cd_favourite"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/progressSeek"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="16dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_track"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:splitTrack="false"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:id="@+id/elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/queuePosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:id="@+id/total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <ImageButton
                    android:id="@+id/modeButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_repeat_off"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@string/cd_mode"/>
                <ImageButton
                    android:id="@+id/prevButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_prev"
                    android:tint="@color/text_primary"
                    android:contentDescription="@string/cd_prev"/>
                <ImageButton
                    android:id="@+id/playButton"
                    android:padding="16dp"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_play"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/cd_play"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <ImageButton
                    android:id="@+id/nextButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_next"
                    android:tint="@color/text_primary"
                    android:contentDescription="@string/cd_next"/>
                <ImageButton
                    android:id="@+id/queueButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_queue"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@string/cd_queue"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <include
        android:id="@+id/volume"
        layout="@layout/volume_pill"/>
</FrameLayout>
