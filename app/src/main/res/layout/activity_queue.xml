<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/screen_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/screen_bg"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:subtitleTextColor="@color/text_secondary"
            app:titleTextColor="@color/text_primary">
            <LinearLayout
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp">
                <ImageButton
                    android:id="@+id/queueSelect"
                    android:src="@drawable/ic_select_mode"
                    android:contentDescription="@string/cd_select"
                    style="@style/CornerButton"/>
                <ImageButton
                    android:id="@+id/queueReorder"
                    android:src="@drawable/ic_reorder"
                    android:contentDescription="@string/cd_reorder"
                    style="@style/CornerButton"/>
                <ImageButton
                    android:id="@+id/queueRemove"
                    android:src="@drawable/ic_trash"
                    android:contentDescription="@string/cd_remove"
                    style="@style/CornerButton"/>
                <ImageButton
                    android:id="@+id/queueClose"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/cd_close"
                    style="@style/CornerButton"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textColor="@color/text_secondary"
                android:layout_gravity="center"
                android:id="@+id/emptyText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/queue_empty"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </FrameLayout>
    </LinearLayout>
    <include
        android:id="@+id/volume"
        layout="@layout/volume_pill"/>
</FrameLayout>
