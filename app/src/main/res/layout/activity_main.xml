<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/screen_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/screen_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:background="@color/screen_bg"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:subtitleTextColor="@color/text_secondary"
                app:titleTextColor="@color/text_primary"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:background="@color/screen_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabGravity="start"
                app:tabIndicatorColor="@color/accent"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/text_primary"
                app:tabTextColor="@color/text_secondary"/>
        </LinearLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/nowPlaying"
            android:background="@color/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/progressTrack"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/accent"
                style="?android:attr/progressBarStyleHorizontal"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">
                <ImageView
                    android:id="@+id/nowCover"
                    android:background="@color/surface"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/nowDetails"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:ellipsize="marquee"
                        android:id="@+id/trackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nothing_playing"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:ellipsize="marquee"
                        android:id="@+id/trackArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"/>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/favouriteButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_favourite"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@string/cd_favourite"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/modeButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_repeat_off"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@string/cd_mode"/>
                <ImageButton
                    android:id="@+id/prevButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_prev"
                    android:tint="@color/text_primary"
                    android:contentDescription="@string/cd_prev"/>
                <ImageButton
                    android:id="@+id/playButton"
                    android:padding="14dp"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_play"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/cd_play"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <ImageButton
                    android:id="@+id/nextButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_next"
                    android:tint="@color/text_primary"
                    android:contentDescription="@string/cd_next"/>
                <ImageButton
                    android:id="@+id/queueButton"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_queue"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@string/cd_queue"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@+id/volume"
        layout="@layout/volume_pill"/>
</FrameLayout>
