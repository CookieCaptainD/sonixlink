<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/screen_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header"
        android:background="@color/surface"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp">
        <ImageButton
            android:id="@+id/headerBack"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:contentDescription="@string/cd_back"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="8dp"/>
        <ImageButton
            android:id="@+id/selQueue"
            android:src="@drawable/ic_list_queue"
            android:contentDescription="@string/sel_queue"
            style="@style/CornerButton"/>
        <ImageButton
            android:id="@+id/selFavAdd"
            android:src="@drawable/ic_star_plus"
            android:contentDescription="@string/sel_fav_add"
            style="@style/CornerButton"/>
        <ImageButton
            android:id="@+id/selPlaylistAdd"
            android:src="@drawable/ic_list_plus"
            android:contentDescription="@string/sel_playlist_add"
            style="@style/CornerButton"/>
        <ImageButton
            android:id="@+id/selFavRemove"
            android:src="@drawable/ic_star_x"
            android:contentDescription="@string/sel_fav_remove"
            style="@style/CornerButton"/>
        <ImageButton
            android:id="@+id/selPlaylistRemove"
            android:src="@drawable/ic_list_x"
            android:contentDescription="@string/sel_playlist_remove"
            style="@style/CornerButton"/>
        <ImageButton
            android:id="@+id/selClose"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/cd_close"
            style="@style/CornerButton"/>
        <ImageButton
            android:id="@+id/playMenu"
            android:src="@drawable/ic_circle_play"
            android:contentDescription="@string/cd_play_menu"
            style="@style/CornerButton"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:id="@+id/letterStrip"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/indexHint"
            android:visibility="gone"
            android:layout_width="132dp"
            android:layout_height="124dp">
            <TextView
                android:textSize="56sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:id="@+id/indexHintLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:textColor="@color/text_secondary"
            android:layout_gravity="center"
            android:id="@+id/emptyText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_list"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </FrameLayout>
</LinearLayout>
